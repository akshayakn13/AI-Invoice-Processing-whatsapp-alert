    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const dueDateStr = item.json[\"Due Date\"];\n  \n  // Parse DD-Mon-YYYY format\n  const dueDate = new Date(dueDateStr);\n  const today = new Date();\n  \n  // Reset time to midnight for clean day calculation\n  today.setHours(0, 0, 0, 0);\n  dueDate.setHours(0, 0, 0, 0);\n  \n  // Calculate days difference\n  const diffMs = dueDate - today;\n  const diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));\n  \n  // Add days and reminder type to item\n  item.json.daysUntilDue = diffDays;\n  \n  if (diffDays === 3) {\n    item.json.reminderType = \"gentle\";\n  } else if (diffDays === 0) {\n    item.json.reminderType = \"urgent\";\n  } else if (diffDays < 0 && diffDays >= -15) {\n    item.json.reminderType = \"overdue\";\n  } else if (diffDays < -15) {\n    item.json.reminderType = \"escalate\";\n  } else {\n    item.json.reminderType = \"none\";\n  }\n}\n\nreturn $input.all();"
      },
